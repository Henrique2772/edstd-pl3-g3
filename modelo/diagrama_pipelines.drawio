 width="210" height="22" as="geometry"/></mxCell><mxCell id="p80" value="Grupo: tabelas de correspondência (leem as Silver dos outros)" style="text;html=1;align=left;verticalAlign=bottom;fontSize=10;fontStyle=3;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="962" y="1214" width="310" height="18" as="geometry"/></mxCell><mxCell id="p81" value="silver.mapa_categorias" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F7F7F;fontSize=10;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="980.0" y="1234" width="250" height="22" as="geometry"/></mxCell><mxCell id="p82" value="dim_categoria_produto" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#B6D7A8;strokeColor=#7F7F7F;fontSize=10;fontColor=#1A1A1A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1435.0" y="1234" width="210" height="22" as="geometry"/></mxCell><mxCell id="p83" value="silver.paises" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F7F7F;fontSize=10;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="980.0" y="1268" width="250" height="22" as="geometry"/></mxCell><mxCell id="p84" value="&lt;b&gt;silver.mapa_categorias&lt;/b&gt; lê as categorias de: superstore_vendas, dataco_itens, olist_itens, marketing_funnel, datafiniti_produtos, amazon_produtos, wc_produtos e rtr_produtos.&lt;br&gt;&lt;b&gt;silver.paises&lt;/b&gt; lê os países de: world_data_2017, superstore_vendas e dataco_itens." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontStyle=2;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="964" y="1310" width="282" height="70" as="geometry"/></mxCell><mxCell id="p85" value="Os factos obtêm &lt;b&gt;sk_categoria_produto&lt;/b&gt; e &lt;b&gt;sk_localizacao&lt;/b&gt; através de silver.mapa_categorias e silver.paises (país: Superstore, DataCo; estado: Olist, INMET)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontStyle=2;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1414" y="1310" width="252" height="70" as="geometry"/></mxCell><mxCell id="t1" value="Bronze: notebooks *bronze_* (upload para o HDFS /projeto/bronze/&amp;lt;nome&amp;gt;/ + tabelas Delta, dados tal como vêm). Silver: notebooks *silver_* (limpeza, tipos e filtro 2017-06-01 a 2017-12-31). Gold: modelo híbrido (script gold: semana 12)." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="1402" width="1640" height="24" as="geometry"/></mxCell><mxCell id="t2" value="&lt;b&gt;Legenda:&lt;/b&gt; cor das setas = elemento do grupo — &lt;font color=&quot;#8E5EA2&quot;&gt;&lt;b&gt;━ Bruno&lt;/b&gt;&lt;/font&gt; · &lt;font color=&quot;#2E6DB4&quot;&gt;&lt;b&gt;━ Diogo&lt;/b&gt;&lt;/font&gt; · &lt;font color=&quot;#1F8A70&quot;&gt;&lt;b&gt;━ Gabriel&lt;/b&gt;&lt;/font&gt; · &lt;font color=&quot;#C55A11&quot;&gt;&lt;b&gt;━ Enzo&lt;/b&gt;&lt;/font&gt; · &lt;font color=&quot;#9C7A00&quot;&gt;&lt;b&gt;━ Quévin&lt;/b&gt;&lt;/font&gt; · &lt;font color=&quot;#B03A3A&quot;&gt;&lt;b&gt;━ Henrique&lt;/b&gt;&lt;/font&gt; · &lt;font color=&quot;#555555&quot;&gt;&lt;b&gt;━ Grupo&lt;/b&gt;&lt;/font&gt; | Gold: laranja = tabela de factos, verde = dimensão | seta = a tabela de destino lê a de origem" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1426" width="1640" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>