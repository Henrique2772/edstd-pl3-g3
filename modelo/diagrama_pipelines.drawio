a &lt;i&gt;silver.*&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3E3E3;strokeColor=#8C8C8C;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fontColor=#1A1A1A;shadow=1;" vertex="1" parent="1"><mxGeometry x="800" y="60" width="370" height="78" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;GOLD&lt;/b&gt; — modelo dimensional (constelação)&lt;br&gt;7 tabelas de factos + dimensões partilhadas&lt;br&gt;&lt;i&gt;(script gold: semana 12)&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE599;strokeColor=#BF9000;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fontColor=#1A1A1A;shadow=1;" vertex="1" parent="1"><mxGeometry x="1220" y="60" width="350" height="78" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Bruno&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=0;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="2" y="160" width="36" height="86" as="geometry"/></mxCell><mxCell id="c7" value="• Marketing Funnel by Olist (2 CSV)&lt;br&gt;• Brazil SELIC and IPCA History (IBGE_IPCA.csv)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fontColor=#1A1A1A;shadow=1;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="330" height="86" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;2.bronze_marketing.ipynb&lt;/b&gt;&lt;br&gt;• bronze.bronze_mql&lt;br&gt;• bronze.bronze_closed_deals&lt;br&gt;• bronze.bronze_ipca" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4CCA8;strokeColor=#B9773A;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fontColor=#1A1A1A;shadow=1;" vertex="1" parent="1"><mxGeometry x="420" y="160" width="330" height="86" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;3.silver_marketing.