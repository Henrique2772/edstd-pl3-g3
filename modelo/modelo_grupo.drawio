ll><mxCell id="dim_localizacao__emissoes_co2_kt_2017" value="&lt;table style=&quot;width:100%;border-collapse:collapse;font-size:10px;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;width:62px;color:#888888;&quot;&gt;BIGINT&lt;/td&gt;&lt;td&gt;emissoes_co2_kt_2017&lt;/td&gt;&lt;td style=&quot;text-align:right;&quot;&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;fontSize=10;" vertex="1" parent="dim_localizacao"><mxGeometry y="202" width="280" height="22" as="geometry"/></mxCell><mxCell id="n1" value="As três tabelas de vendas ficam separadas (processos de empresas diferentes) e relacionam-se pelo calendário, pela categoria e pela localização (o Brasil aparece no Superstore, no DataCo e na Olist). sk_localizacao = país/estado do cliente. Cada tabela liga ao calendário só pela data da encomenda/compra: envio, entrega e atrasos ficam como medidas em dias." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontStyle=2;fontSize=11;fontColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="80" y="120" width="600" height="160" as="geometry"/></mxCell><mxCell id="fact_macro_mensal" value="fact_macro_mensal" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#F3C98B;fontColor=#000000;swimlaneFillColor=#FFFFFF;strokeColor=#666666;fontSize=12;html=1;rounded=0;" vertex="1" parent="1"><mxGeometry x="760" y="1290" width="320" height="70" as="geometry"/></mxCell><mxCell id="fact_macro_mensal__sk_calendario" value="&lt;table style=&quot;width:100%;border-collapse:collapse;font-size:10px;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;width:62px;color:#888888;&quot;&gt;INT&lt;/td&gt;&lt;td&gt;&lt;b&gt;sk_calendario&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;text-align:right;&quot;&gt;&lt;span style=&quot;background:#FFF2CC;border:1px