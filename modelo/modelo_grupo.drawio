omendado" value="&lt;table style=&quot;width:100%;border-collapse:collapse;font-size:10px;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;width:62px;color:#888888;&quot;&gt;BOOLEAN&lt;/td&gt;&lt;td&gt;is_recomendado&lt;/td&gt;&lt;td style=&quot;text-align:right;&quot;&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;fontSize=10;" vertex="1" parent="fact_avaliacoes"><mxGeometry y="224" width="320" height="22" as="geometry"/></mxCell><mxCell id="fact_avaliacoes__is_incoerente" value="&lt;table style=&quot;width:100%;border-collapse:collapse;font-size:10px;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;width:62px;color:#888888;&quot;&gt;BOOLEAN&lt;/td&gt;&lt;td&gt;is_incoerente&lt;/td&gt;&lt;td style=&quot;text-align:right;&quot;&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;fontSize=10;" vertex="1" parent="fact_avaliacoes"><mxGeometry y="246" width="320" height="22" as="geometry"/></mxCell><mxCell id="fact_avaliacoes__ajuste" value="&lt;table style=&quot;width:100%;border-collapse:collapse;font-size:10px;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;width:62px;color:#888888;&quot;&gt;STRING&lt;/td&gt;&lt;td&gt;ajuste&lt;/td&gt;&lt;td style=&quot;text-align:right;&quot;&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;fontSize=10;" vertex="1" parent="fact_avaliacoes"><mxGeometry y="268" width="320" height="22" as="geometry"/></mxCell><mxCell id="n4" value="Uma só tabela para as avaliações das quatro lojas (coluna fonte); nota_5 põe todas as notas na escala de 1 a 5. Só de algumas fontes: is_recomendado e is_incoerente (Women's Clothing), ajuste (Rent the Runway), order_id (Olist, liga à fact_itens_olist). A dim_produto (partilhada com a área 3) tem as peças de roupa e os eletrónicos. Valor inexistente = registo -1 (o Women's Clothing não tem data; a Olist avalia a encomenda e não o produto)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontStyle=2;fontSize=11;fontColor=#B85450;" vertex="1" parent="1"><mxGeometry x="2160" y="1000" width="280" height="310" as="geometry"/></mxCell><mxCell id="leg" value="Legenda: laranja = tabela de factos | azul = dimensão de uma só área | verde = dimensão partilhada (conforme) | PK = chave primária | FK = chave estrangeira | relações 1 - N (pé de galinha = muitos) | valores desconhecidos = registo -1 de cada dimensão" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="1665" width="2440" height="30" as="geometry"/></mxCell><mxCell id="e0" value="sk_calendario" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#8C8C8C;strokeWidth=1;fontSize=9;fontColor=#666666;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.2398;exitDx=0;exitDy=0;entryX=0;entryY=0.1904;entryDx=0;entryDy=0;" edge="1" parent="1" source="fact_vendas_superstore" target="dim_calendario"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1166" y="179.0"/><mxPoint x="1166" y="379.4"/></Array></mxGeometry></mxCell><mxCell id="e1" value="sk_localizacao" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#8C8C8C;strokeWidth=1;fontSize=9;fontColor=#666666;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.3293;exitDx=0;exitDy=0;entryX=1;entryY=0.2467;entryDx=0;entryDy=0;" edge="1" parent="1" source="fact_vendas_superstore" target="dim_localizacao"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="710" y="201.0"/><mxPoint x="710" y="815.2"/></Array></mxGeometry></mxCell><mxCell id="e2" value="sk_categoria_p