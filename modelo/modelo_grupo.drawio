tml=1;strokeColor=none;verticalAlign=middle;overflow=hidden;rotatable=0;connectable=0;fontSize=10;fillColor=#FFFFFF;" vertex="1" parent="dim_perfil_avaliacao"><mxGeometry x="1" y="114" width="278" height="22" as="geometry"/></mxCell><mxCell id="dim_perfil_avaliacao__incoerente__t" value="STRING" style="html=1;strokeColor=none;verticalAlign=middle;overflow=hidden;rotatable=0;connectable=0;fontSize=10;fillColor=none;align=left;spacingLeft=8;fontColor=#7A7A7A;" vertex="1" parent="dim_perfil_avaliacao"><mxGeometry x="0" y="114" width="64" height="22" as="geometry"/></mxCell><mxCell id="dim_perfil_avaliacao__incoerente" value="incoerente" style="html=1;strokeColor=none;verticalAlign=middle;overflow=hidden;rotatable=0;connectable=0;fontSize=10;fillColor=none;align=left;spacingLeft=2;fontColor=#1A1A1A;fontStyle=0;" vertex="1" parent="dim_perfil_avaliacao"><mxGeometry x="64" y="114" width="170" height="22" as="geometry"/></mxCell><mxCell id="n4" value="Uma só tabela para as avaliações das quatro lojas; nota_5 põe todas as notas na escala 1–5.&lt;br&gt;dim_perfil_avaliacao (junk): fonte + ajuste (RTR), recomendado e incoerente (Women's Clothing: Sim/Não); nas outras fontes = &quot;Não aplicável&quot;.&lt;br&gt;Olist: avalia a encomenda (order_id liga à fact_itens_olist): produto e categoria = -1, sk_localizacao = estado do cliente. Women's Clothing: sem data, sk_calendario = -1 (filtrar nas análises temporais)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontStyle=2;fontSize=11;fontColor=#B85450;" vertex="1" parent="1"><mxGeometry x="2160" y="1150" width="290" height="210" as="geometry"/></mxCell><mxCell id="leg" value="Legenda: laranja = tabela de factos | azul = dimensão de uma só área | verde = dimensão partilhada (conforme) | PK = chave primária | FK = chave estrangeira | DD = dimensão degenerada (identificador da origem guardado no facto) | relações 1 - N (pé de galinha = muitos) | valores desconhecidos = registo -1 de cada dimensão" style="text;htm