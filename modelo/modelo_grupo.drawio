ddle;overflow=hidden;rotatable=0;connectable=0;fontSize=10;fillColor=#FFFFFF;" vertex="1" parent="fact_avaliacoes"><mxGeometry x="1" y="246" width="318" height="22" as="geometry"/></mxCell><mxCell id="fact_avaliacoes__is_incoerente__t" value="BOOLEAN" style="html=1;strokeColor=none;verticalAlign=middle;overflow=hidden;rotatable=0;connectable=0;fontSize=10;fillColor=none;align=left;spacingLeft=8;fontColor=#7A7A7A;" vertex="1" parent="fact_avaliacoes"><mxGeometry x="0" y="246" width="64" height="22" as="geometry"/></mxCell><mxCell id="fact_avaliacoes__is_incoerente" value="is_incoerente" style="html=1;strokeColor=none;verticalAlign=middle;overflow=hidden;rotatable=0;connectable=0;fontSize=10;fillColor=none;align=left;spacingLeft=2;fontColor=#1A1A1A;fontStyle=0;" vertex="1" parent="fact_avaliacoes"><mxGeometry x="64" y="246" width="210" height="22" as="geometry"/></mxCell><mxCell id="fact_avaliacoes__ajuste__bg" value="" style="html=1;strokeColor=none;verticalAlign=middle;overflow=hidden;rotatable=0;connectable=0;fontSize=10;fillColor=#F7F7F7;" vertex="1" parent="fact_avaliacoes"><mxGeometry x="1" y="268" width="318" height="22" as="geometry"/></mxCell><mxCell id="fact_avaliacoes__ajuste__t" value="STRING" style="html=1;strokeColor=none;verticalAlign=middle;overflow=hidden;rotatable=0;connectable=0;fontSize=10;fillColor=none;align=left;spacingLeft=8;fontColor=#7A7A7A;" vertex="1" parent="fact_avaliacoes"><mxGeometry x="0" y="268" width="64" height="22" as="geometry"/></mxCell><mxCell id="fact_avaliacoes__ajuste" value="ajuste" style="html=1;strokeColor=none;verticalAlign=middle;overflow=hidden;rotatable=0;connectable=0;fontSize=10;fillColor=none;align=left;spacingLeft=2;fontColor=#1A1A1A;fontStyle=0;" vertex="1" parent="fact_avaliacoes"><mxGeometry x="64" y="268" width="210" height="22" as="geometry"/></mxCell><mxCell id="n4" value="Uma só tabela para as avaliações das quatro lojas (coluna fonte); nota_5 põe todas as notas na escala de 1 a 5. Só de algumas fontes: is_recomendado e is_incoerente (Women's Clothing), ajuste (Rent the Runway), order_id (Olist, liga à fact_itens_olist). A dim_produto (partilhada com a área 3) tem as peças de roupa e os eletrónicos. Valor inexistente = registo -1 (o Women's Clothing não tem data; a Olist avalia a encomenda e não o produto)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontStyle=2;fontSize=11;fontColor=#B85450;" vertex="1" parent="1"><mxGeometry x="2160" y="1000" width="280" height="310" as="geometry"/></mxCell><mxCell id="leg" value="Legenda: laranja = tabela de factos | azul = dimensão de uma só área | verde = dimensão partilhada (conforme) | PK = chave primária | FK = chave estrangeira | relações 1 - N (pé de galinha = muitos) | valores desconhecidos = registo -1 de cada dimensão" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="1665" width="2440" height="30" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#555555;labelBackgroundColor=none;jumpStyle=none;exitX=1;exitY=0.2398;exitDx=0;exitDy=0;entryX=0;entryY=0.1186;entryDx=0;entryDy=0;" edge="1" parent="1" source="fact_vendas_superstore" target="dim_calendario"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1238" y="179.0"/><mxPoint x="1238" y="357.0"/></Array></mxGeometry></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#555555;labelBackgroundColor=none;jumpStyle=none;exitX=0;exitY=0.3293;exitDx=0;exitDy=0;entryX=1;entryY=0.1652;entryDx=0;entryDy=0;" edge="1" parent="1" source="fact_vendas_superstore" target="dim_localizacao"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="682" y="201.0"/><mxPoint x="682" y="797.0"/></Array></mxGeometry></mxCell><mxCell id="e2"