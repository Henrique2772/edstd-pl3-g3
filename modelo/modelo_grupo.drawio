2" width="340" height="26" as="geometry"/></mxCell><mxCell id="n_e" value="A dim_localizacao é usada duas vezes (estado do cliente e do vendedor) e a dim_tempo três vezes (compra, entrega, entrega estimada). A meteorologia é por estado e dia, por isso cruza com os atrasos pelo estado do cliente e pela data. As avaliações da Olist estão na fact_avaliacao (ligam pelo order_id)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontStyle=2;fontColor=#555555;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2620" y="900" width="340" height="240" as="geometry"/></mxCell><mxCell id="a1" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;fontStyle=2;html=1;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#555555;labelBackgroundColor=none;" edge="1" parent="1" source="fact_avaliacao_id_produto" target="dim_produto_id_produto"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a2" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;fontStyle=2;html=1;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#555555;labelBackgroundColor=none;" edge="1" parent="1" source="fact_avaliacao_id_tempo" target="dim_tempo_id_tempo (AAAAMMDD)"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a3" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;fontStyle=2;html=1;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#555555;labelBackgroundColor=none;" edge="1" parent="1" source="fact_avaliacao_id_cliente" target="dim_cliente_id_cliente"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d1" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;fontStyle=2;html=1;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#555555;labelBackgroundColor=none;" edge="1" parent="1" source="fact_item_encomenda_id_produto" target="dim_produto_id_produto"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d2" value="encomenda" style="e