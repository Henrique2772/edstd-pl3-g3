connectable=0;fontSize=10;fillColor=none;align=left;spacingLeft=2;fontColor=#1A1A1A;fontStyle=0;" vertex="1" parent="dim_perfil_encomenda"><mxGeometry x="64" y="48" width="170" height="22" as="geometry"/></mxCell><mxCell id="dim_perfil_encomenda__mercado__bg" value="" style="html=1;strokeColor=none;verticalAlign=middle;overflow=hidden;rotatable=0;connectable=0;fontSize=10;fillColor=#FFFFFF;" vertex="1" parent="dim_perfil_encomenda"><mxGeometry x="1" y="70" width="278" height="22" as="geometry"/></mxCell><mxCell id="dim_perfil_encomenda__mercado__t" value="STRING" style="html=1;strokeColor=none;verticalAlign=middle;overflow=hidden;rotatable=0;connectable=0;fontSize=10;fillColor=none;align=left;spacingLeft=8;fontColor=#7A7A7A;" vertex="1" parent="dim_perfil_encomenda"><mxGeometry x="0" y="70" width="64" height="22" as="geometry"/></mxCell><mxCell id="dim_perfil_encomenda__mercado" value="mercado" style="html=1;strokeColor=none;verticalAlign=middle;overflow=hidden;rotatable=0;connectable=0;fontSize=10;fillColor=none;align=left;spacingLeft=2;fontColor=#1A1A1A;fontStyle=0;" vertex="1" parent="dim_perfil_encomenda"><mxGeometry x="64" y="70" width="170" height="22" as="geometry"/></mxCell><mxCell id="dim_perfil_encomenda__estado_encomenda__bg" value="" style="html=1;strokeColor=none;verticalAlign=middle;overflow=hidden;rotatable=0;connectable=0;fontSize=10;fillColor=#F7F7F7;" vertex="1" parent="dim_perfil_encomenda"><mxGeometry x="1" y="92" width="278" height="22" as="geometry"/></mxCell><mxCell id="dim_perfil_encomenda__estado_encomenda__t" value="STRING" style="html=1;strokeColor=none;verticalAlign=middle;overflow=hidden;rotatable=0;connectable=0;fontSize=10;fillColor=none;align=left;spacingLeft=8;fontColor=#7A7A7A;" vertex="1" parent="dim_perfil_encomenda"><mxGeometry x="0" y="92" width="64" height="22" as="geometry"/></mxCell><mxCell id="dim_perfil_encomenda__estado_encomenda" value="estado_encomenda" style="html=1;strokeColor=none;verticalAlign=middle;overflow=hidden;rotatable=0;connectable=0;fontSize=10;fillColor=none;align=left;spacingLeft=2;fontColor=#1A1A1A;fontStyle=0;" vertex="1" parent="dim_perfil_encomenda"><mxGeometry x="64" y="92" width="170" height="22" as="geometry"/></mxCell><mxCell id="n1" value="As três tabelas de vendas ficam separadas (processos de empresas diferentes) e relacionam-se pelo calendário, pela categoria e pela localização. Cada tabela liga ao calendário só pela data da encomenda/compra: envio, entrega e atrasos ficam como medidas em dias.&lt;br&gt;&lt;br&gt;sk_localizacao: país no Superstore, estado da encomenda no DataCo, estado do cliente na Olist (coluna nivel).&lt;br&gt;&lt;br&gt;dim_perfil_encomenda (junk, partilhada pelo Superstore e pelo DataCo): modo de envio, mercado e estado da encomenda (o Superstore não tem estado: &quot;Não aplicável&quot;). Os mercados são os mesmos nas duas fontes (Asia Pacific = Pacific Asia).&lt;br&gt;&lt;br&gt;desconto_pct (Superstore, taxa 0–1) ≠ desconto_valor (DataCo, em dinheiro). Olist: dias_entrega, dias_atraso e is_atrasada são da encomenda e repetem-se por item; contar com COUNT(DISTINCT order_id)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontStyle=2;fontSize=11;fontColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="80" y="110" width="600" height="310" as="geometry"/></mxCell><mxCell id="fact_meteorologia_diaria" value="fact_meteorologia_diaria" style="swimlane;fontStyle=1;horizontal=1;startSize=26;collapsible=0;fillColor=#F3C98B;fontColor=#000000;swimlaneFillColor=#FFFFFF;strokeColor=#B7884A;fontSize=12;html=1;rounded=1;arcSize=6;absoluteArcSize=1;shadow=1;swimlaneLine=1;" vertex="1" parent="1"><mxGeometry x="760" y="1290" width="320" height="180" as="geometry"/></mxCell><mxCell id="fact_meteorologia_diaria__sk_meteorologia__bg" value="" style="html=1;strokeColor=none;verticalAlign=middle;overflow=hidden;rotatable=0;connectable=0;fontSize=10;fillColor=#FFFFFF;" vertex="1" parent="fact_meteorologia_diaria"><mxGeometry x="1" y="26" 